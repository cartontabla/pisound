# AES67 network interface used by ptp4l/phc2sys.
# Override this on the Pi if the wired NIC is not named eth0.
AES67_IFACE=eth0

# Optional extra interfaces passed to ptp4l.
# For the "Pi as grandmaster" topology, enabling loopback here helps the
# local RAVENNA driver see the local PTP master.
# AES67_PTP_EXTRA_IFACES=lo

# Set to 1 when ptp4l needs software timestamping, for example when running on
# both the wired NIC and loopback at the same time.
# AES67_PTP_SOFTWARE_TS=1

# Optional override for the PHC device used by phc2sys when sysfs does not
# expose /sys/class/net/<iface>/device/ptp on the target kernel.
# AES67_PHC_DEVICE=/dev/ptp0
