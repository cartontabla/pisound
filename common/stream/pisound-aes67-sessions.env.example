# Session restore defaults for the Pi-side aes67-daemon integration.
#
# Architecture:
# - Mac bridge publishes the stream consumed by Pi stream_in as PISOUND_AES67_TX_NAME.
# - Pi source publishes the stream produced by Pi stream_out as PISOUND_AES67_RX_NAME.

PISOUND_AES67_API_BASE=http://127.0.0.1:8090
PISOUND_AES67_TX_NAME=Pisound_In
PISOUND_AES67_RX_NAME=Pisound_Out
PISOUND_AES67_RX_ADDRESS=239.69.0.3
PISOUND_AES67_PAYLOAD_TYPE=98
PISOUND_AES67_CHANNELS=2
PISOUND_AES67_MAX_SAMPLES_PER_PACKET=48
PISOUND_AES67_DELAY=1024
PISOUND_AES67_DISCOVER_TIMEOUT=60
PISOUND_AES67_DISCOVER_INTERVAL=1
PISOUND_AES67_WATCH_INTERVAL=2
