# Optional per-project runtime overrides for stream projects over RAVENNA.
#
# Copy this file to <project>/<project>_ravenna.env to override the defaults
# used by <project>_app and pisound-stream-ravenna@<project>.service.

STREAM_BACKEND=alsa
STREAM_SAMPLE_FORMAT=s32le
STREAM_DEVICE=hw:CARD=RAVENNA,DEV=0
STREAM_CAPTURE_DEVICE=hw:CARD=RAVENNA,DEV=0
STREAM_PLAYBACK_DEVICE=hw:CARD=RAVENNA,DEV=0

# Open a wider hardware layout than the model and map the logical channels
# explicitly onto the hardware slots.
#
# Example:
# STREAM_CAPTURE_HW_CHANNELS=4
# STREAM_PLAYBACK_HW_CHANNELS=4
# STREAM_CAPTURE_MAP=0,2
# STREAM_PLAYBACK_MAP=0,2
